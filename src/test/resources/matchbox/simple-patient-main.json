{
  "resourceType": "StructureMap",
  "id": "simple-patient-main",
  "url": "http://example.org/fhir/StructureMap/simple-patient-main",
  "name": "SimplePatientMain",
  "status": "active",
  "import": [
    "http://example.org/fhir/StructureMap/simple-patient-common"
  ],
  "structure": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Patient",
      "mode": "source"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Patient",
      "mode": "target"
    }
  ],
  "group": [
    {
      "name": "main",
      "typeMode": "types",
      "input": [
        {
          "name": "src",
          "type": "Patient",
          "mode": "source"
        },
        {
          "name": "tgt",
          "type": "Patient",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "delegate",
          "source": [
            {
              "context": "src"
            }
          ],
          "target": [
            {
              "context": "tgt"
            }
          ],
          "dependent": [
            {
              "name": "copyId",
              "variable": [
                "src",
                "tgt"
              ]
            }
          ]
        }
      ]
    }
  ]
}